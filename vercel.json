{
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "api/_aeroportos.json"
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/verificar-alertas",
      "schedule": "0 8 * * *"
    }
  ]
}